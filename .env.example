# Cliente Supabase — usado en browser y server, respeta Row Level Security automáticamente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cliente con privilegios de servicio (bypassa RLS). SOLO uso server-side
# (jobs de cron, exports de reportes). Nunca exponer al bundle de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa de Postgres, usada por Drizzle ORM (migraciones y
# queries de reportería). Se obtiene en Supabase > Project Settings > Database
# > Connection string (modo "Transaction" recomendado para entornos serverless).
# No es la misma variable que NEXT_PUBLIC_SUPABASE_URL de arriba.
DATABASE_URL=
